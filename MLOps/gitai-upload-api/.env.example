# Copy to .env for local runs. Cloud Run should use env vars or Secret Manager.

# Optional global API gate for all endpoints (/auth/* and /ingest/*).
# If blank, per-user session auth still protects /ingest.
API_KEY=

# Required: GCS destination for uploaded Python change payloads (JSON diffs)
GCS_BUCKET=your-bucket-name
GCS_OBJECT_PREFIX=gitai-python

# GCS bucket where full Python source files are stored AND where prod_pipeline reads them.
# MUST match KG_agent's GCS_BUCKET_NAME so the pipeline can find uploaded files.
# Default: codebases-04-03-26
PYTHON_FILES_BUCKET=codebases-04-03-26

# BigQuery users table location (also sets GOOGLE_CLOUD_PROJECT for ADC client libs)
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET=gitai
BQ_USERS_TABLE=users

# Session expiration for login tokens
SESSION_TTL_HOURS=24

# ── KG pipeline — subprocess runner ────────────────────────────────────────
# Absolute path to prod_pipeline.py. Auto-detected from repo layout if blank.
KG_PIPELINE_SCRIPT=

# Python interpreter that has KG_agent dependencies installed.
# Defaults to the same interpreter running this API server.
# In production set this to the venv that has langchain, neo4j, google-cloud-*, etc.
KG_PIPELINE_PYTHON=

# Neo4j / AuraDB logical database name.
# Leave blank to let prod_pipeline use its own default (correct for AuraDB where the
# server-default database name varies per instance).
KG_PIPELINE_DATABASE=

# Seconds to wait for the pipeline subprocess before reporting a timeout.
# The pipeline can take several minutes for large codebases.
KG_PIPELINE_TIMEOUT_SECONDS=600

# ── Cloud Run Job for KG pipeline (recommended for production) ─────────────
# Name of the pre-created Cloud Run Job that runs prod_pipeline.py.
# When set, file uploads trigger a Cloud Run Job execution instead of a local
# subprocess — no KG deps needed in this container, fully serverless.
# See Ops_Project/KG_agent/Dockerfile for the Job image.
CLOUD_RUN_KG_JOB_NAME=

# GCP project + region where the Cloud Run Job lives.
# CLOUD_RUN_PROJECT defaults to BQ_PROJECT_ID if blank.
CLOUD_RUN_PROJECT=
CLOUD_RUN_REGION=us-central1

# ── KG pipeline — optional remote worker ───────────────────────────────────
# Alternative to Cloud Run Jobs: delegate KG work to a custom HTTP worker service.
# Leave blank when using CLOUD_RUN_KG_JOB_NAME.
KG_WORKER_BASE_URL=
KG_WORKER_API_KEY=

# ── KG pipeline — structural track tuning ──────────────────────────────────
# File summaries per extraction batch. Larger batches give the LLM more
# cross-file context for architecture/dependency edges. Default: 4
KG_STRUCTURAL_BATCH_SIZE=

# Summaries shared between adjacent batches (overlap for boundary context). Default: 2
KG_STRUCTURAL_BATCH_OVERLAP=

# Hard character cap per structural summary. Prevents token-limit errors. Default: 1600
KG_STRUCTURAL_MAX_DOC_CHARS=

# ── KG pipeline — technical track tuning ───────────────────────────────────
# Per-file batching (1) for code-accurate entity extraction. Default: 1
KG_TECHNICAL_BATCH_SIZE=

# Overlap for technical batches. Usually 0 since batches are per-file. Default: 0
KG_TECHNICAL_BATCH_OVERLAP=

# Higher cap than structural to preserve implementation detail. Default: 2800
KG_TECHNICAL_MAX_DOC_CHARS=

# ── Vertex AI RAG Engine (per-user empty corpus on /auth/register) ─────────
# Project and region for Vertex. VERTEX_PROJECT defaults to BQ_PROJECT_ID.
# Default region is europe-west4 (Netherlands) for Spanner-backed RAG without
# Serverless-only allowlists in us-central1. Override with VERTEX_LOCATION.
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west4

# Publisher embedding model for corpus creation (Spanner RAG). Default:
# publishers/google/models/text-embedding-004
RAG_EMBEDDING_PUBLISHER_MODEL=

# If 1/true, /auth/register returns HTTP 502 when corpus creation fails.
# Default (blank/0) is lenient: registration still succeeds and rag_corpus_id is null.
RAG_CORPUS_REQUIRED_ON_REGISTER=

# Local dev only if needed:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
